{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Markets repository distillation report",
  "description": "Version 1.0.0. Structural validity does not establish evidence truth, interoperability, or production deployment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "process_version",
    "prompt_version",
    "record_type",
    "report_id",
    "audited_at",
    "target",
    "scope",
    "standards",
    "deployments",
    "evidence",
    "claims",
    "event_kinds",
    "integrations",
    "builds",
    "interoperability",
    "lineage",
    "candidates",
    "ranking"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "process_version": {
      "const": "1.0.0"
    },
    "prompt_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "enum": [
        "audit",
        "example"
      ]
    },
    "report_id": {
      "$ref": "#/$defs/text"
    },
    "previous_report_id": {
      "$ref": "#/$defs/nullableText"
    },
    "audited_at": {
      "type": "string",
      "format": "date-time"
    },
    "cohort": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/cohort"
        }
      ]
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "standards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/standard"
      }
    },
    "deployments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deployment"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "event_kinds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eventKind"
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/integration"
      }
    },
    "builds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/build"
      }
    },
    "interoperability": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interoperability"
      }
    },
    "lineage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lineage"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "ranking": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/ranking"
        }
      ]
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "nullableText": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "strings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "uniqueItems": true
    },
    "commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "description": "Full lowercase Git SHA-1 or Git SHA-256 commit ID; null means unresolved."
    },
    "dateOrNull": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "implementation": {
      "enum": [
        "implemented",
        "partial",
        "declared_only",
        "not_found_in_scope",
        "not_implemented",
        "unknown",
        "not_applicable"
      ]
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "comparison_cutoff",
        "observation_window",
        "source_scope_policy",
        "baseline_ids",
        "baseline_digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "comparison_cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "observation_window": {
          "$ref": "#/$defs/text"
        },
        "source_scope_policy": {
          "$ref": "#/$defs/text"
        },
        "baseline_ids": {
          "$ref": "#/$defs/strings"
        },
        "baseline_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repository",
        "commit",
        "ref",
        "components",
        "roles"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "ref": {
          "$ref": "#/$defs/nullableText"
        },
        "components": {
          "$ref": "#/$defs/strings"
        },
        "roles": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded",
        "limitations"
      ],
      "properties": {
        "included": {
          "$ref": "#/$defs/strings"
        },
        "excluded": {
          "$ref": "#/$defs/strings"
        },
        "limitations": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "commit",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "status": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "environment",
        "provenance",
        "observed_at",
        "deployed_commit",
        "evidence_ids"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "environment": {
          "$ref": "#/$defs/text"
        },
        "provenance": {
          "enum": [
            "unverified",
            "project_claimed",
            "observed",
            "commit_linked"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/dateOrNull"
        },
        "deployed_commit": {
          "$ref": "#/$defs/commit"
        },
        "evidence_ids": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "location",
        "revision",
        "locator",
        "observed_at",
        "summary",
        "limitations"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "enum": [
            "documentation",
            "source",
            "test_definition",
            "test_run",
            "deployment_observation",
            "deployment_binding",
            "release",
            "standard",
            "negative_search",
            "dependency",
            "maintainer_statement"
          ]
        },
        "location": {
          "$ref": "#/$defs/text"
        },
        "revision": {
          "$ref": "#/$defs/nullableText"
        },
        "locator": {
          "$ref": "#/$defs/text"
        },
        "observed_at": {
          "$ref": "#/$defs/dateOrNull"
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "limitations": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capability_id",
        "statement",
        "statement_type",
        "implementation",
        "execution",
        "availability",
        "evidence_ids",
        "limitations"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "capability_id": {
          "$ref": "#/$defs/text"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "statement_type": {
          "enum": [
            "observed",
            "inferred",
            "proposed"
          ]
        },
        "implementation": {
          "$ref": "#/$defs/implementation"
        },
        "execution": {
          "enum": [
            "not_run",
            "passed",
            "failed",
            "blocked",
            "not_applicable"
          ]
        },
        "availability": {
          "enum": [
            "default",
            "opt_in",
            "experimental",
            "disabled",
            "unknown"
          ]
        },
        "evidence_ids": {
          "$ref": "#/$defs/strings"
        },
        "limitations": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "eventKind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "purpose",
        "layer",
        "variant",
        "standard_ids",
        "operations",
        "contract",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "purpose": {
          "$ref": "#/$defs/text"
        },
        "layer": {
          "enum": [
            "relay_event",
            "seal",
            "rumor",
            "application_payload",
            "auth_event",
            "http_authorization",
            "local_object",
            "unknown"
          ]
        },
        "variant": {
          "$ref": "#/$defs/text"
        },
        "standard_ids": {
          "$ref": "#/$defs/strings"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "contract": {
          "oneOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "object",
              "minProperties": 1
            }
          ]
        },
        "evidence_ids": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "status",
        "claim_ids"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "$ref": "#/$defs/implementation"
        },
        "claim_ids": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "name",
        "declared_version",
        "resolved_version",
        "status",
        "evidence_ids",
        "notes"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "declared_version": {
          "$ref": "#/$defs/nullableText"
        },
        "resolved_version": {
          "$ref": "#/$defs/nullableText"
        },
        "status": {
          "enum": [
            "dependency_present",
            "wired",
            "locally_verified",
            "deployment_verified",
            "unknown"
          ]
        },
        "evidence_ids": {
          "$ref": "#/$defs/strings"
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "runtime",
        "command",
        "status",
        "evidence_ids",
        "limitations"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/text"
        },
        "runtime": {
          "$ref": "#/$defs/text"
        },
        "command": {
          "$ref": "#/$defs/nullableText"
        },
        "status": {
          "enum": [
            "not_attempted",
            "blocked",
            "failed",
            "passed"
          ]
        },
        "evidence_ids": {
          "$ref": "#/$defs/strings"
        },
        "limitations": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repository",
        "commit",
        "role"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "role": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "interoperability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "consumer",
        "capability_id",
        "variant",
        "direction",
        "status",
        "evidence_ids",
        "limitations"
      ],
      "properties": {
        "producer": {
          "$ref": "#/$defs/peer"
        },
        "consumer": {
          "$ref": "#/$defs/peer"
        },
        "capability_id": {
          "$ref": "#/$defs/text"
        },
        "variant": {
          "$ref": "#/$defs/text"
        },
        "direction": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "not_assessed",
            "code_predicted",
            "fixture_passed",
            "live_observed",
            "failed",
            "blocked"
          ]
        },
        "evidence_ids": {
          "$ref": "#/$defs/strings"
        },
        "limitations": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_ids",
        "family_id",
        "independence",
        "evidence_ids"
      ],
      "properties": {
        "capability_ids": {
          "$ref": "#/$defs/strings"
        },
        "family_id": {
          "$ref": "#/$defs/text"
        },
        "independence": {
          "enum": [
            "independent",
            "shared",
            "unknown"
          ]
        },
        "evidence_ids": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "problem",
        "proposal",
        "status",
        "evidence_ids",
        "conflicts",
        "next_evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "problem": {
          "$ref": "#/$defs/text"
        },
        "proposal": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "observed_pattern",
            "conflict",
            "experimental",
            "candidate",
            "needs_evidence"
          ]
        },
        "evidence_ids": {
          "$ref": "#/$defs/strings"
        },
        "conflicts": {
          "$ref": "#/$defs/strings"
        },
        "next_evidence": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_sha256",
        "criteria",
        "summary"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/text"
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterionScore"
          }
        },
        "summary": {
          "$ref": "#/$defs/scoreSummary"
        }
      }
    },
    "criterionScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "points",
        "claim_ids",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "points": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            0,
            1,
            2,
            null
          ]
        },
        "claim_ids": {
          "$ref": "#/$defs/strings"
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "scoreSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper",
        "max",
        "known",
        "total",
        "coverage_percent",
        "eligible"
      ],
      "properties": {
        "lower": {
          "type": "integer",
          "minimum": 0
        },
        "upper": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "known": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "coverage_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "eligible": {
          "type": "boolean",
          "description": "Mechanical source-evidence eligibility only. Ordinal placement also requires cohort and human review; this is never an automatic global rank."
        }
      }
    }
  }
}
